# Copie para .env.local e preencha com os dados do app Web do seu projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → Web). Sem estes valores, o app fica sem login.
# Estes identificadores vão para o navegador por definição; a proteção dos dados está nas regras do Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
