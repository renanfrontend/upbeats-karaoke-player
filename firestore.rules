rules_version = '2';

// Cada conta só lê e grava o próprio documento (users/<uid>), com os campos da biblioteca.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['liked', 'recent', 'offsets', 'unliked', 'songs', 'removedSongs', 'updatedAt'])
        && request.resource.data.liked is list && request.resource.data.liked.size() <= 2000
        && request.resource.data.recent is list && request.resource.data.recent.size() <= 50
        && request.resource.data.songs is list && request.resource.data.songs.size() <= 2000;
    }
    // Todo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
